{
  "expo": {
    "name": "AgroGest",
    "slug": "agrogest",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/v2/icon-v2.png",
    "scheme": "agrogest",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.agrogest.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C502F",
        "foregroundImage": "./assets/images/v2/android-icon-foreground-v2.png",
        "backgroundImage": "./assets/images/v2/android-icon-background-v2.png",
        "monochromeImage": "./assets/images/v2/android-icon-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/v2/favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/v2/splash-icon-v2.png",
          "imageWidth": 132,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/v2/splash-icon-dark-v2.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O AgroGest usa a câmera para fotografar notas fiscais."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O AgroGest usa sua localização para centralizar o mapa da fazenda."
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
