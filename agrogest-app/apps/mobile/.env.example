# Public address only; no model/provider credential belongs in the mobile bundle.
# Leave blank for web: same origin as the app (local or hosted), with a Metro exception.
# Native defaults to loopback; set an explicit public HTTPS API origin for a future cloud build.
EXPO_PUBLIC_API_URL=
